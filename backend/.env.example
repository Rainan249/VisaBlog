# 后端监听地址
ADDR=:8080

# 单用户账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# 生产建议改用 bcrypt 哈希（留空则使用 ADMIN_PASSWORD）
# ADMIN_PASSWORD_HASH=

# 会话签名密钥（留空会启动时随机生成，重启后登录态失效）
SESSION_SECRET=please-change-to-a-long-random-string

# 内容目录：默认直接写前端工程，方便本地即时看到效果
NOTES_DIR=../fronted/posts
IMAGES_DIR=../fronted/public/uploads

# 测试期可设为 true，跳过登录（生产务必保持 false）
AUTH_DISABLED=false

# 意见反馈存储目录
FEEDBACK_DIR=data/feedback

# 部署在 HTTPS 后面时设为 true
COOKIE_SECURE=false

# 若前端与后端不同源（不经过 Vite 代理），填前端地址
# ALLOWED_ORIGIN=http://localhost:5199
